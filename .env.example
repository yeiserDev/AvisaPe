# ── Supabase ────────────────────────────────────────────────
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo del lado del servidor. Se salta RLS: nunca la expongas al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ── Avisos push (VAPID) ─────────────────────────────────────
# Genera el par con: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tucorreo@ejemplo.com

# ── Despachador de avisos ───────────────────────────────────
# Secreto que protege /api/cron/dispatch. Invéntalo largo y aleatorio.
CRON_SECRET=
# Zona horaria usada en el texto de las notificaciones.
APP_TIMEZONE=America/Lima
